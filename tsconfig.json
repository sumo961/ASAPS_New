{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@asaps/core": ["packages/core/src"],
      "@asaps/core/*": ["packages/core/src/*"],
      "@asaps/builder": ["packages/builder/src"],
      "@asaps/builder/*": ["packages/builder/src/*"],
      "@asaps/renderer": ["packages/renderer/src"],
      "@asaps/renderer/*": ["packages/renderer/src/*"]
    }
  },
  "references": [
    { "path": "./packages/core" },
    { "path": "./packages/renderer" }
  ]
}