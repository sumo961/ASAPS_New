import React from 'react';
import { Beat } from '@asaps/core';
import { X, Save, Trash2, Copy, Info, Plus, Link, Unlink, MapPin, Package } from 'lucide-react';
import beatDefinitions from '../../../../beat-definitions/core-beats.json';

interface InspectorProps {
  beat: Beat | null;
  onUpdate: (beatId: string, updates: Partial<Beat>) => void;
  onDelete: (beatId: string) => void;
  allBeats?: Beat[];
  onConnect?: (sourceBeatId: string, targetBeatId: string) => void;
  onDisconnect?: (sourceBeatId: string, targetBeatId: string) => void;
}

export const Inspector: React.FC<InspectorProps> = ({
  beat,
  onUpdate,
  onDelete,
  allBeats = [],
  onConnect,
  onDisconnect,
}) => {
  const [localBeat, setLocalBeat] = React.useState<any>(null);
  const [hasChanges, setHasChanges] = React.useState(false);
  const [newConnectionTarget, setNewConnectionTarget] = React.useState('');

  // Get beat definition from schema
  const getBeatDefinition = (beatType: string) => {
    return beatDefinitions.beatTypes[beatType as keyof typeof beatDefinitions.beatTypes];
  };

  React.useEffect(() => {
    if (beat) {
      // Create a deep copy of the beat data including parameters
      const beatData = beat.toJSON();
      beatData.connections = beat.getConnections ? beat.getConnections() : [];
      
      // Ensure parameters object exists using new getParameters method
      beatData.parameters = beat.getParameters ? beat.getParameters() : {};
      
      // Initialize choices/props for multi-connection beats if not present
      const beatDef = getBeatDefinition(beat.type);
      if (beatDef?.connectionType === 'multiple') {
        if (beat.type === 'movementChoice' && !beatData.parameters.choices) {
          beatData.parameters.choices = [];
        } else if (beat.type === 'pickProp' && !beatData.parameters.props) {
          beatData.parameters.props = [];
        }
      }
      
      setLocalBeat(beatData);
      setHasChanges(false);
      setNewConnectionTarget('');
    }
  }, [beat]);

  if (!beat || !localBeat) {
    return (
      <div className="w-80 bg-white border-l border-gray-200 p-6">
        <div className="text-center text-gray-500">
          <Info className="w-12 h-12 mx-auto mb-3 text-gray-300" />
          <p className="text-sm">Select a beat to view its properties</p>
        </div>
      </div>
    );
  }

  const beatDef = getBeatDefinition(beat.type);
  const connectionType = beatDef?.connectionType || 'single';

  const handleChange = (field: string, value: any) => {
    setLocalBeat((prev: any) => ({
      ...prev,
      [field]: value,
    }));
    setHasChanges(true);
  };

  const handleParameterChange = (param: string, value: any) => {
    setLocalBeat((prev: any) => ({
      ...prev,
      parameters: {
        ...prev.parameters,
        [param]: value,
      },
    }));
    setHasChanges(true);
  };

  const handleTransitionChange = (field: string, value: any) => {
    setLocalBeat((prev: any) => ({
      ...prev,
      transition: {
        ...prev.transition,
        [field]: value,
      },
    }));
    setHasChanges(true);
  };

  const handleSoundChange = (field: string, value: any) => {
    setLocalBeat((prev: any) => ({
      ...prev,
      sound: {
        ...prev.sound,
        [field]: value,
      },
    }));
    setHasChanges(true);
  };

  const handleSave = () => {
    if (beat) {
      // Update basic properties
      beat.name = localBeat.name;
      beat.cluster = localBeat.cluster;
      beat.defaultTarget = localBeat.defaultTarget || undefined;
      beat.transition = localBeat.transition;
      beat.sound = localBeat.sound;
      
      // Update parameters using the new updateParameters method
      if (localBeat.parameters && beat.updateParameters) {
        beat.updateParameters(localBeat.parameters);
      }
      
      // Handle connections based on beat type
      const beatDef = getBeatDefinition(beat.type);
      const connectionType = beatDef?.connectionType || 'single';
      
      // Clear existing connections
      const connections = beat.getConnections();
      while (connections.length > 0) {
        connections.pop();
      }
      
      // Add connections based on type
      if (connectionType === 'single' && localBeat.connections.length > 0) {
        beat.addConnection(localBeat.connections[0]);
      } else if (connectionType === 'multiple') {
        // For multiple connection beats, connections come from choices/props
        if (beat.type === 'movementChoice' && localBeat.parameters?.choices) {
          localBeat.parameters.choices.forEach((choice: any) => {
            if (choice.target) {
              beat.addConnection({
                targetId: choice.target,
                label: choice.text
              });
            }
          });
        } else if (beat.type === 'pickProp' && localBeat.parameters?.props) {
          localBeat.parameters.props.forEach((prop: any) => {
            if (prop.target) {
              beat.addConnection({
                targetId: prop.target,
                label: prop.name
              });
            }
          });
        }
      } else if (connectionType === 'conditional') {
        // Handle conditional beats
        const trueConn = localBeat.connections.find((c: any) => c.label === 'true');
        const falseConn = localBeat.connections.find((c: any) => c.label === 'false');
        if (trueConn) beat.addConnection(trueConn);
        if (falseConn) beat.addConnection(falseConn);
      } else {
        // Add all connections for other types
        localBeat.connections.forEach((conn: any) => beat.addConnection(conn));
      }
      
      // Trigger update with the beat object itself (now with updated parameters)
      onUpdate(beat.id, beat);
      setHasChanges(false);
    }
  };

  const handleDelete = () => {
    if (window.confirm(`Are you sure you want to delete "${beat.name}"?`)) {
      onDelete(beat.id);
    }
  };

  const handleAddConnection = () => {
    if (!newConnectionTarget) return;

    const beatDef = getBeatDefinition(beat.type);
    const connectionType = beatDef?.connectionType || 'single';

    if (connectionType === 'single') {
      // Replace existing connection for single-connection beats
      setLocalBeat((prev: any) => ({
        ...prev,
        connections: [{
          targetId: newConnectionTarget,
          label: prev.parameters?.buttonText || 'Continue'
        }]
      }));
    } else if (connectionType === 'conditional') {
      // Add as true/false connection
      const hasTrue = localBeat.connections.some((c: any) => c.label === 'true');
      setLocalBeat((prev: any) => ({
        ...prev,
        connections: [
          ...prev.connections,
          {
            targetId: newConnectionTarget,
            label: hasTrue ? 'false' : 'true'
          }
        ]
      }));
    } else {
      // Add new connection for other types
      setLocalBeat((prev: any) => ({
        ...prev,
        connections: [
          ...prev.connections,
          {
            targetId: newConnectionTarget,
            label: `To ${allBeats.find(b => b.id === newConnectionTarget)?.name || newConnectionTarget}`
          }
        ]
      }));
    }
    
    setHasChanges(true);
    setNewConnectionTarget('');
  };

  const handleRemoveConnection = (targetId: string) => {
    setLocalBeat((prev: any) => ({
      ...prev,
      connections: prev.connections.filter((c: any) => c.targetId !== targetId)
    }));
    setHasChanges(true);
  };

  // Handle adding choices for movementChoice beats
  const handleAddChoice = () => {
    setLocalBeat((prev: any) => ({
      ...prev,
      parameters: {
        ...prev.parameters,
        choices: [
          ...(prev.parameters.choices || []),
          {
            id: `choice_${Date.now()}`,
            text: 'New Choice',
            location: 'Location',
            target: ''
          }
        ]
      }
    }));
    setHasChanges(true);
  };

  const handleUpdateChoice = (index: number, field: string, value: any) => {
    setLocalBeat((prev: any) => {
      const choices = [...(prev.parameters.choices || [])];
      choices[index] = { ...choices[index], [field]: value };
      return {
        ...prev,
        parameters: {
          ...prev.parameters,
          choices
        }
      };
    });
    setHasChanges(true);
  };

  const handleRemoveChoice = (index: number) => {
    setLocalBeat((prev: any) => ({
      ...prev,
      parameters: {
        ...prev.parameters,
        choices: prev.parameters.choices.filter((_: any, i: number) => i !== index)
      }
    }));
    setHasChanges(true);
  };

  // Handle adding props for pickProp beats
  const handleAddProp = () => {
    setLocalBeat((prev: any) => ({
      ...prev,
      parameters: {
        ...prev.parameters,
        props: [
          ...(prev.parameters.props || []),
          {
            id: `prop_${Date.now()}`,
            name: 'New Prop',
            description: 'Description',
            target: ''
          }
        ]
      }
    }));
    setHasChanges(true);
  };

  const handleUpdateProp = (index: number, field: string, value: any) => {
    setLocalBeat((prev: any) => {
      const props = [...(prev.parameters.props || [])];
      props[index] = { ...props[index], [field]: value };
      return {
        ...prev,
        parameters: {
          ...prev.parameters,
          props
        }
      };
    });
    setHasChanges(true);
  };

  const handleRemoveProp = (index: number) => {
    setLocalBeat((prev: any) => ({
      ...prev,
      parameters: {
        ...prev.parameters,
        props: prev.parameters.props.filter((_: any, i: number) => i !== index)
      }
    }));
    setHasChanges(true);
  };

  const beatTypeParameters: Record<string, any> = {
    titleScreen: {
      title: { type: 'text', label: 'Title', default: 'Untitled Story' },
      author: { type: 'text', label: 'Author', default: 'Anonymous' },
      buttonText: { type: 'text', label: 'Button Text', default: 'Start' },
    },
    introText: {
      text: { type: 'textarea', label: 'Text Content', default: '' },
      buttonText: { type: 'text', label: 'Button Text', default: 'Continue' },
    },
    dialogTree: {
      speaker: { type: 'text', label: 'Speaker', default: 'Character' },
      text: { type: 'textarea', label: 'Dialog Text', default: '' },
      emotion: { type: 'select', label: 'Emotion', options: ['neutral', 'happy', 'sad', 'angry', 'surprised'] },
    },
    movementChoice: {
      question: { type: 'text', label: 'Question', default: 'Where do you want to go?' },
    },
    pickProp: {
      question: { type: 'text', label: 'Question', default: 'What do you want to pick up?' },
    },
    conversationChoice: {
      questioner: { type: 'text', label: 'Speaker', default: 'Character' },
      question: { type: 'textarea', label: 'Question', default: '' },
    },
    videoBeat: {
      videoFile: { type: 'text', label: 'Video File', default: '' },
      autoplay: { type: 'checkbox', label: 'Autoplay', default: true },
      controls: { type: 'checkbox', label: 'Show Controls', default: true },
      skipButton: { type: 'checkbox', label: 'Skip Button', default: true },
    },
    durScreen: {
      text: { type: 'textarea', label: 'Text', default: '' },
      duration: { type: 'number', label: 'Duration (ms)', default: 3000 },
    },
    endScreen: {
      message: { type: 'text', label: 'End Message', default: 'The End' },
      showRestart: { type: 'checkbox', label: 'Show Restart', default: true },
      showCredits: { type: 'checkbox', label: 'Show Credits', default: false },
    },
    setVariable: {
      variable: { type: 'text', label: 'Variable Name', default: '' },
      value: { type: 'text', label: 'Value', default: '' },
      operation: { type: 'select', label: 'Operation', options: ['set', 'add', 'subtract', 'multiply', 'divide'] },
    },
    conditionBeat: {
      // Condition parameters will be handled separately
    },
  };

  const parameters = beatTypeParameters[beat.type] || {};
  const availableTargets = allBeats.filter(b => b.id !== beat.id);

  return (
    <div className="w-80 bg-white border-l border-gray-200 flex flex-col">
      {/* Header */}
      <div className="p-4 border-b border-gray-200">
        <div className="flex items-center justify-between mb-2">
          <h2 className="text-lg font-semibold text-gray-800">Properties</h2>
          {hasChanges && (
            <span className="text-xs text-orange-500 font-medium">Unsaved changes</span>
          )}
        </div>
        <div className="text-sm text-gray-500">
          {beat.type} • ID: {beat.id}
        </div>
        <div className="text-xs text-gray-400 mt-1">
          Connection Type: {connectionType}
        </div>
      </div>

      {/* Properties */}
      <div className="flex-1 overflow-y-auto p-4 space-y-4">
        {/* Basic Properties */}
        <div className="space-y-3">
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-1">
              Name
            </label>
            <input
              type="text"
              value={localBeat.name}
              onChange={(e) => handleChange('name', e.target.value)}
              className="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>

          <div>
            <label className="block text-sm font-medium text-gray-700 mb-1">
              Cluster (Optional)
            </label>
            <input
              type="text"
              value={localBeat.cluster || ''}
              onChange={(e) => handleChange('cluster', e.target.value)}
              placeholder="Group beats together"
              className="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>
        </div>

        {/* Beat-specific Parameters */}
        {Object.keys(parameters).length > 0 && (
          <div className="border-t pt-4">
            <h3 className="text-sm font-semibold text-gray-700 mb-3">
              Beat Parameters
            </h3>
            <div className="space-y-3">
              {Object.entries(parameters).map(([key, param]: [string, any]) => (
                <div key={key}>
                  <label className="block text-sm font-medium text-gray-700 mb-1">
                    {param.label}
                  </label>
                  
                  {param.type === 'text' && (
                    <input
                      type="text"
                      value={localBeat.parameters?.[key] || ''}
                      onChange={(e) => handleParameterChange(key, e.target.value)}
                      placeholder={param.default || ''}
                      className="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                  )}
                  
                  {param.type === 'number' && (
                    <input
                      type="number"
                      value={localBeat.parameters?.[key] ?? param.default ?? 0}
                      onChange={(e) => handleParameterChange(key, parseInt(e.target.value) || 0)}
                      className="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                  )}
                  
                  {param.type === 'textarea' && (
                    <textarea
                      value={localBeat.parameters?.[key] || ''}
                      onChange={(e) => handleParameterChange(key, e.target.value)}
                      placeholder={param.default || ''}
                      rows={3}
                      className="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                    />
                  )}
                  
                  {param.type === 'checkbox' && (
                    <label className="flex items-center gap-2">
                      <input
                        type="checkbox"
                        checked={localBeat.parameters?.[key] ?? param.default ?? false}
                        onChange={(e) => handleParameterChange(key, e.target.checked)}
                        className="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
                      />
                      <span className="text-sm text-gray-700">Enable</span>
                    </label>
                  )}
                  
                  {param.type === 'select' && (
                    <select
                      value={localBeat.parameters?.[key] || param.default || param.options[0]}
                      onChange={(e) => handleParameterChange(key, e.target.value)}
                      className="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                    >
                      {param.options.map((option: string) => (
                        <option key={option} value={option}>
                          {option.charAt(0).toUpperCase() + option.slice(1)}
                        </option>
                      ))}
                    </select>
                  )}
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Connections Section */}
        {connectionType !== 'none' && (
          <div className="border-t pt-4">
            <h3 className="text-sm font-semibold text-gray-700 mb-3 flex items-center gap-2">
              <Link className="w-4 h-4" />
              Connections
              {connectionType === 'single' && (
                <span className="text-xs bg-blue-100 text-blue-700 px-2 py-0.5 rounded">Single</span>
              )}
              {connectionType === 'multiple' && (
                <span className="text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded">Multiple</span>
              )}
              {connectionType === 'conditional' && (
                <span className="text-xs bg-purple-100 text-purple-700 px-2 py-0.5 rounded">Conditional</span>
              )}
            </h3>
            
            {/* Handle different connection types */}
            {connectionType === 'single' && (
              <>
                {localBeat.connections && localBeat.connections.length > 0 ? (
                  <div className="mb-3">
                    {localBeat.connections.map((conn: any, index: number) => {
                      const targetBeat = allBeats.find(b => b.id === conn.targetId);
                      return (
                        <div key={index} className="flex items-center gap-2 p-2 bg-gray-50 rounded">
                          <span className="flex-1 text-sm">
                            → {targetBeat?.name || conn.targetId}
                          </span>
                          <button
                            onClick={() => handleRemoveConnection(conn.targetId)}
                            className="p-1 text-red-500 hover:bg-red-50 rounded"
                            title="Remove connection"
                          >
                            <Unlink className="w-3 h-3" />
                          </button>
                        </div>
                      );
                    })}
                  </div>
                ) : (
                  <p className="text-xs text-gray-500 mb-3">No connection set</p>
                )}
                
                {/* Add/Replace connection */}
                <div className="flex gap-2">
                  <select
                    value={newConnectionTarget}
                    onChange={(e) => setNewConnectionTarget(e.target.value)}
                    className="flex-1 px-2 py-1 border border-gray-300 rounded text-sm"
                  >
                    <option value="">Select target...</option>
                    {availableTargets.map(target => (
                      <option key={target.id} value={target.id}>
                        {target.name} ({target.id})
                      </option>
                    ))}
                  </select>
                  <button
                    onClick={handleAddConnection}
                    disabled={!newConnectionTarget}
                    className="px-2 py-1 bg-blue-500 text-white rounded text-sm disabled:bg-gray-300"
                    title={localBeat.connections?.length > 0 ? "Replace connection" : "Add connection"}
                  >
                    {localBeat.connections?.length > 0 ? 'Replace' : 'Add'}
                  </button>
                </div>
              </>
            )}

            {connectionType === 'multiple' && beat.type === 'movementChoice' && (
              <div className="space-y-3">
                <div className="flex items-center justify-between mb-2">
                  <span className="text-xs text-gray-600">Movement Choices</span>
                  <button
                    onClick={handleAddChoice}
                    className="text-xs bg-green-500 text-white px-2 py-1 rounded hover:bg-green-600 flex items-center gap-1"
                  >
                    <Plus className="w-3 h-3" />
                    Add Choice
                  </button>
                </div>
                {localBeat.parameters?.choices?.map((choice: any, index: number) => (
                  <div key={choice.id || index} className="p-3 bg-gray-50 rounded-lg space-y-2">
                    <div className="flex items-center justify-between">
                      <span className="text-xs font-medium text-gray-600">Choice {index + 1}</span>
                      <button
                        onClick={() => handleRemoveChoice(index)}
                        className="text-red-500 hover:bg-red-50 p-1 rounded"
                      >
                        <X className="w-3 h-3" />
                      </button>
                    </div>
                    <input
                      type="text"
                      value={choice.text}
                      onChange={(e) => handleUpdateChoice(index, 'text', e.target.value)}
                      placeholder="Choice text"
                      className="w-full px-2 py-1 text-sm border border-gray-300 rounded"
                    />
                    <input
                      type="text"
                      value={choice.location}
                      onChange={(e) => handleUpdateChoice(index, 'location', e.target.value)}
                      placeholder="Location"
                      className="w-full px-2 py-1 text-sm border border-gray-300 rounded"
                    />
                    <select
                      value={choice.target || ''}
                      onChange={(e) => handleUpdateChoice(index, 'target', e.target.value)}
                      className="w-full px-2 py-1 text-sm border border-gray-300 rounded"
                    >
                      <option value="">Select target beat...</option>
                      {availableTargets.map(target => (
                        <option key={target.id} value={target.id}>
                          {target.name} ({target.id})
                        </option>
                      ))}
                    </select>
                  </div>
                ))}
              </div>
            )}

            {connectionType === 'multiple' && beat.type === 'pickProp' && (
              <div className="space-y-3">
                <div className="flex items-center justify-between mb-2">
                  <span className="text-xs text-gray-600">Props</span>
                  <button
                    onClick={handleAddProp}
                    className="text-xs bg-green-500 text-white px-2 py-1 rounded hover:bg-green-600 flex items-center gap-1"
                  >
                    <Plus className="w-3 h-3" />
                    Add Prop
                  </button>
                </div>
                {localBeat.parameters?.props?.map((prop: any, index: number) => (
                  <div key={prop.id || index} className="p-3 bg-gray-50 rounded-lg space-y-2">
                    <div className="flex items-center justify-between">
                      <span className="text-xs font-medium text-gray-600">Prop {index + 1}</span>
                      <button
                        onClick={() => handleRemoveProp(index)}
                        className="text-red-500 hover:bg-red-50 p-1 rounded"
                      >
                        <X className="w-3 h-3" />
                      </button>
                    </div>
                    <input
                      type="text"
                      value={prop.name}
                      onChange={(e) => handleUpdateProp(index, 'name', e.target.value)}
                      placeholder="Prop name"
                      className="w-full px-2 py-1 text-sm border border-gray-300 rounded"
                    />
                    <input
                      type="text"
                      value={prop.description}
                      onChange={(e) => handleUpdateProp(index, 'description', e.target.value)}
                      placeholder="Description"
                      className="w-full px-2 py-1 text-sm border border-gray-300 rounded"
                    />
                    <select
                      value={prop.target || ''}
                      onChange={(e) => handleUpdateProp(index, 'target', e.target.value)}
                      className="w-full px-2 py-1 text-sm border border-gray-300 rounded"
                    >
                      <option value="">Select target beat...</option>
                      {availableTargets.map(target => (
                        <option key={target.id} value={target.id}>
                          {target.name} ({target.id})
                        </option>
                      ))}
                    </select>
                  </div>
                ))}
              </div>
            )}

            {connectionType === 'conditional' && (
              <div className="space-y-2">
                <p className="text-xs text-gray-600">Conditional connections</p>
                {localBeat.connections?.filter((c: any) => c.label === 'true').map((conn: any) => {
                  const targetBeat = allBeats.find(b => b.id === conn.targetId);
                  return (
                    <div key={conn.targetId} className="flex items-center gap-2 p-2 bg-green-50 rounded">
                      <span className="text-xs font-medium text-green-700">TRUE →</span>
                      <span className="flex-1 text-sm">{targetBeat?.name || conn.targetId}</span>
                      <button
                        onClick={() => handleRemoveConnection(conn.targetId)}
                        className="p-1 text-red-500 hover:bg-red-50 rounded"
                      >
                        <X className="w-3 h-3" />
                      </button>
                    </div>
                  );
                })}
                {localBeat.connections?.filter((c: any) => c.label === 'false').map((conn: any) => {
                  const targetBeat = allBeats.find(b => b.id === conn.targetId);
                  return (
                    <div key={conn.targetId} className="flex items-center gap-2 p-2 bg-red-50 rounded">
                      <span className="text-xs font-medium text-red-700">FALSE →</span>
                      <span className="flex-1 text-sm">{targetBeat?.name || conn.targetId}</span>
                      <button
                        onClick={() => handleRemoveConnection(conn.targetId)}
                        className="p-1 text-red-500 hover:bg-red-50 rounded"
                      >
                        <X className="w-3 h-3" />
                      </button>
                    </div>
                  );
                })}
                <div className="flex gap-2 mt-2">
                  <select
                    value={newConnectionTarget}
                    onChange={(e) => setNewConnectionTarget(e.target.value)}
                    className="flex-1 px-2 py-1 border border-gray-300 rounded text-sm"
                  >
                    <option value="">Select target...</option>
                    {availableTargets.map(target => (
                      <option key={target.id} value={target.id}>
                        {target.name} ({target.id})
                      </option>
                    ))}
                  </select>
                  <button
                    onClick={handleAddConnection}
                    disabled={!newConnectionTarget || localBeat.connections?.length >= 2}
                    className="px-2 py-1 bg-blue-500 text-white rounded text-sm disabled:bg-gray-300"
                  >
                    Add {localBeat.connections?.some((c: any) => c.label === 'true') ? 'False' : 'True'}
                  </button>
                </div>
              </div>
            )}
          </div>
        )}

        {/* Transition Settings */}
        <div className="border-t pt-4">
          <h3 className="text-sm font-semibold text-gray-700 mb-3">
            Transition
          </h3>
          <div className="space-y-3">
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">
                Type
              </label>
              <select
                value={localBeat.transition?.type || 'none'}
                onChange={(e) => handleTransitionChange('type', e.target.value)}
                className="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
              >
                <option value="none">None</option>
                <option value="fade">Fade</option>
                <option value="slide">Slide</option>
                <option value="zoom">Zoom</option>
                <option value="dissolve">Dissolve</option>
              </select>
            </div>
            
            {localBeat.transition?.type && localBeat.transition.type !== 'none' && (
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">
                  Duration (ms)
                </label>
                <input
                  type="number"
                  value={localBeat.transition?.duration || 500}
                  onChange={(e) => handleTransitionChange('duration', parseInt(e.target.value))}
                  className="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
              </div>
            )}
          </div>
        </div>

        {/* Sound Settings */}
        <div className="border-t pt-4">
          <h3 className="text-sm font-semibold text-gray-700 mb-3">
            Sound
          </h3>
          <div className="space-y-3">
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1">
                Sound File
              </label>
              <input
                type="text"
                value={localBeat.sound?.file || ''}
                onChange={(e) => handleSoundChange('file', e.target.value)}
                placeholder="path/to/sound.mp3"
                className="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
              />
            </div>
            
            {localBeat.sound?.file && (
              <>
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">
                    Volume (0-1)
                  </label>
                  <input
                    type="number"
                    step="0.1"
                    min="0"
                    max="1"
                    value={localBeat.sound?.volume || 1}
                    onChange={(e) => handleSoundChange('volume', parseFloat(e.target.value))}
                    className="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                  />
                </div>
                
                <label className="flex items-center gap-2">
                  <input
                    type="checkbox"
                    checked={localBeat.sound?.loop || false}
                    onChange={(e) => handleSoundChange('loop', e.target.checked)}
                    className="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
                  />
                  <span className="text-sm text-gray-700">Loop</span>
                </label>
              </>
            )}
          </div>
        </div>
      </div>

      {/* Footer Actions */}
      <div className="p-4 border-t border-gray-200 space-y-2">
        <button
          onClick={handleSave}
          disabled={!hasChanges}
          className={`w-full py-2 px-4 rounded-lg text-sm font-medium transition-colors flex items-center justify-center gap-2 ${
            hasChanges
              ? 'bg-blue-500 text-white hover:bg-blue-600'
              : 'bg-gray-100 text-gray-400 cursor-not-allowed'
          }`}
        >
          <Save className="w-4 h-4" />
          Save Changes
        </button>
        
        <div className="flex gap-2">
          <button
            onClick={() => {
              navigator.clipboard.writeText(beat.id);
              alert(`Beat ID "${beat.id}" copied to clipboard`);
            }}
            className="flex-1 py-2 px-4 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors flex items-center justify-center gap-2"
          >
            <Copy className="w-4 h-4" />
            Copy ID
          </button>
          
          <button
            onClick={handleDelete}
            className="flex-1 py-2 px-4 border border-red-300 rounded-lg text-sm font-medium text-red-600 hover:bg-red-50 transition-colors flex items-center justify-center gap-2"
          >
            <Trash2 className="w-4 h-4" />
            Delete
          </button>
        </div>
      </div>
    </div>
  );
};
