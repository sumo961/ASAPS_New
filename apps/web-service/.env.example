# Server Configuration
PORT=3001
NODE_ENV=development
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# Session
SESSION_SECRET=your-secret-key-here-change-in-production

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/asaps?schema=public

# OAuth - Google (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - GitHub (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Storage Configuration
# Options: local, s3, r2
STORAGE_TYPE=local
STORAGE_PATH=./uploads
STORAGE_URL=http://localhost:3001/uploads

# S3/R2 Configuration (if STORAGE_TYPE=s3 or r2)
S3_BUCKET=asaps-assets
S3_REGION=auto
S3_ENDPOINT=  # For Cloudflare R2: https://account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_URL=  # Optional CDN URL for serving assets
