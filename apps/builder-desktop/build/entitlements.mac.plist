<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron's JIT (V8) under the hardened runtime -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Native modules (e.g. better-sqlite-style addons) aren't Apple-signed -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Story beats: QR scan + AR scene (camera), voice input/STT (mic),
         GPS beats (location). Without these the hardened runtime silently
         denies the corresponding getUserMedia/geolocation requests. -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.personal-information.location</key>
    <true/>
  </dict>
</plist>
