<?xml version="1.0" encoding="UTF-8"?>
<story title="Counter Operations Test" author="ASPS Demo">
  <settings>
    <debug firstbeat="0" showvals="on" />
  </settings>
  
  <environment />
  
  <characters>
    <character id="c1" name="Player" role="player">
      <counter name="health" value="100" min="0" max="100" />
      <counter name="courage" value="50" min="0" max="100" />
      <counter name="gold" value="10" min="0" max="999" />
    </character>
  </characters>
  
  <plot>
    <clusters />
    
    <!-- Dialog Tree with counter operations -->
    <beat>
      <id id="1" name="Merchant Dialog" />
      <transition type="fade" duration="500" />
      <function kind="dialogTree" speaker="Merchant" text="Welcome! What would you like?">
        <choice id="1" text="Buy health potion (-5 gold, +20 health)" counter="gold" operation="change" val="-5">
          <target>
            <dialogTree speaker="Merchant" text="Here's your potion!">
              <choice id="1" text="Thank you" counter="health" operation="change" val="20" target="2" />
            </dialogTree>
          </target>
        </choice>
        <choice id="2" text="Rob the merchant (set gold to 50)" counter="gold" operation="set" val="50" target="3" />
        <choice id="3" text="Leave peacefully (+5 courage)" counter="courage" operation="change" val="5" target="2" />
      </function>
    </beat>
    
    <!-- Movement Choice with counter operations -->
    <beat>
      <id id="2" name="Path Choice" />
      <function kind="movementChoice" question="Which path will you take?">
        <choice id="1" text="Dark forest (-10 health, +15 courage)" location="A dangerous path" counter="health" operation="change" val="-10" target="4" />
        <choice id="2" text="Safe road (set courage to 30)" location="The easy path" counter="courage" operation="set" val="30" target="4" />
        <choice id="3" text="Mountain pass (+5 all)" location="The high road" counter="health" operation="change" val="5" target="4" />
      </function>
    </beat>
    
    <!-- Pick Prop with counter operations -->
    <beat>
      <id id="3" name="Treasure Room" />
      <function kind="pickProp" question="What will you take?">
        <prop id="1" name="Gold Coins" description="A pile of gold" counter="gold" operation="change" val="25" target="4" />
        <prop id="2" name="Magic Ring" description="Sets your courage to maximum" counter="courage" operation="set" val="100" target="4" />
        <prop id="3" name="Healing Herb" description="Restores some health" counter="health" operation="change" val="15" target="4" />
      </function>
    </beat>
    
    <!-- End -->
    <beat>
      <id id="4" name="End" />
      <function kind="endScreen" message="The End" showRestart="true" />
    </beat>
  </plot>
</story>
