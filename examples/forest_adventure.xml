<?xml version="1.0" encoding="UTF-8"?>
<story title="The Forest Adventure" author="ASAPS Demo" version="2.0.0">
  <settings>
    <debug firstbeat="0" showvals="off" />
    <colors pcolor="0x7D8DA3" palpha="90" />
    <fonts titleFont="Georgia" textFont="Arial" />
    <textbox radius="20" />
  </settings>
  
  <environment>
    <prop id="p1" name="Magic Sword" file="sword.png">A gleaming magical sword</prop>
    <prop id="p2" name="Health Potion" file="potion.png">Restores health when consumed</prop>
    <prop id="p3" name="Ancient Map" file="map.png">Shows the way through the forest</prop>
    
    <node id="n1" name="Forest Entrance" file="forest_entrance.jpg" />
    <node id="n2" name="Dark Path" file="dark_path.jpg" />
    <node id="n3" name="Clearing" file="clearing.jpg" />
    <node id="n4" name="Cave Entrance" file="cave.jpg" />
  </environment>
  
  <characters>
    <character id="c1" name="Hero" role="player">
      <counter name="health" value="100" min="0" max="100" />
      <counter name="courage" value="50" min="0" max="100" />
    </character>
    <character id="c2" name="Old Wizard" role="npc" />
    <character id="c3" name="Forest Guardian" role="npc" />
  </characters>
  
  <plot>
    <clusters />
    
    <!-- Title Screen -->
    <beat>
      <id id="0" name="Title Screen" />
      <transition type="fade" duration="1000" />
      <function kind="titleScreen" 
               title="The Forest Adventure" 
               author="ASPAS Demo" 
               buttonText="Begin Adventure" />
      <connection target="1" />
    </beat>
    
    <!-- Introduction -->
    <beat>
      <id id="1" name="Story Introduction" />
      <transition type="fade" duration="500" />
      <sound file="forest_ambience.mp3" volume="0.5" loop="true" />
      <function kind="introText" 
               text="You stand at the edge of an ancient forest. Dark trees tower above you, their branches intertwining to form a canopy that blocks out most of the sunlight. You've heard tales of a powerful artifact hidden deep within, but also warnings of the dangers that await those who enter..." 
               buttonText="Enter the Forest" />
      <connection target="2" />
    </beat>
    
    <!-- First Choice - Movement -->
    <beat>
      <id id="2" name="Forest Entrance" />
      <location kind="text" name="description" x="100" y="100" width="600" height="100" />
      <function kind="movementChoice" 
               question="Where do you want to go?">
        <choice id="1" text="Follow the main path" location="Well-traveled road" target="3" />
        <choice id="2" text="Take the dark side path" location="Shadowy trail" target="4" />
        <choice id="3" text="Explore the undergrowth" location="Dense bushes" target="5" />
      </function>
    </beat>
    
    <!-- Main Path - Dialog with Wizard -->
    <beat>
      <id id="3" name="Meeting the Wizard" />
      <transition type="slide" duration="500" direction="in" />
      <function kind="dialogTree">
        <dialogTree id="root" speaker="Old Wizard" text="Halt, traveler! I see you seek the artifact. Many have tried, few have succeeded." emotion="serious">
          <choice id="1" text="Tell me about the artifact" target="wizard_info" />
          <choice id="2" text="I don't need your help" target="wizard_offended" />
          <choice id="3" text="What dangers await?" target="wizard_warning" />
        </dialogTree>
      </function>
      <connection target="6" />
    </beat>
    
    <!-- Dark Path - Condition Check -->
    <beat>
      <id id="4" name="Dark Path Courage Check" />
      <function kind="conditionBeat" 
               trueTarget="7" 
               falseTarget="8">
        <condition type="counter" operator=">=" left="courage" right="60" />
      </function>
    </beat>
    
    <!-- Undergrowth - Pick Prop -->
    <beat>
      <id id="5" name="Found Items" />
      <function kind="pickProp" 
               question="You find some items hidden in the undergrowth. What do you take?">
        <prop id="p1" name="Magic Sword" description="A gleaming blade with runes" target="9" />
        <prop id="p2" name="Health Potion" description="A red glowing liquid" target="10" />
        <prop id="p3" name="Ancient Map" description="Shows forest paths" target="11" />
      </function>
    </beat>
    
    <!-- Wizard Info Branch -->
    <beat>
      <id id="6" name="Wizard's Knowledge" />
      <function kind="introText" 
               text="The wizard tells you: 'The artifact is an ancient amulet that grants its bearer great power. But beware - the Forest Guardian protects it jealously. You'll need courage and wisdom to succeed.'" 
               buttonText="Thank the wizard" />
      <connection target="12" />
    </beat>
    
    <!-- Brave Dark Path -->
    <beat>
      <id id="7" name="Brave the Darkness" />
      <function kind="introText" 
               text="Your courage serves you well! You navigate the dark path with confidence, discovering a shortcut that leads you deeper into the forest. You can hear the sound of running water ahead." 
               buttonText="Continue" />
      <connection target="13" />
    </beat>
    
    <!-- Too Scared -->
    <beat>
      <id id="8" name="Turn Back" />
      <function kind="introText" 
               text="The darkness is too overwhelming. Your fear gets the better of you, and you stumble back to the main path, your heart racing. Perhaps you need more courage for this route." 
               buttonText="Return to entrance" />
      <connection target="2" />
    </beat>
    
    <!-- Got Sword -->
    <beat>
      <id id="9" name="Equipped Sword" />
      <function kind="setVariable" variable="hasSword" value="true" />
      <connection target="12" />
    </beat>
    
    <!-- Got Potion -->
    <beat>
      <id id="10" name="Took Potion" />
      <function kind="setVariable" variable="hasPotion" value="true" />
      <connection target="12" />
    </beat>
    
    <!-- Got Map -->
    <beat>
      <id id="11" name="Found Map" />
      <function kind="setVariable" variable="hasMap" value="true" />
      <connection target="12" />
    </beat>
    
    <!-- Convergence Point -->
    <beat>
      <id id="12" name="Deep Forest" />
      <transition type="dissolve" duration="1000" />
      <function kind="introText" 
               text="You venture deeper into the forest. The trees grow denser, and strange sounds echo through the foliage. You sense you're getting closer to your goal. Suddenly, a massive creature blocks your path - the Forest Guardian!" 
               buttonText="Face the Guardian" />
      <connection target="13" />
    </beat>
    
    <!-- Guardian Encounter -->
    <beat>
      <id id="13" name="Guardian Battle" />
      <function kind="dialogTree">
        <dialogTree id="root" speaker="Forest Guardian" text="WHO DARES ENTER MY DOMAIN?" emotion="angry">
          <choice id="1" text="I seek the artifact peacefully">
            <condition type="variable" operator="==" left="hasSword" right="false" />
            <next target="14" />
          </choice>
          <choice id="2" text="Stand aside, or face my blade!">
            <condition type="variable" operator="==" left="hasSword" right="true" />
            <next target="15" />
          </choice>
          <choice id="3" text="I have a map that shows another way">
            <condition type="variable" operator="==" left="hasMap" right="true" />
            <next target="16" />
          </choice>
        </dialogTree>
      </function>
    </beat>
    
    <!-- Peaceful Resolution -->
    <beat>
      <id id="14" name="Peaceful Ending" />
      <transition type="fade" duration="2000" />
      <function kind="endScreen" 
               message="The Guardian, impressed by your peaceful approach, grants you safe passage. You obtain the artifact and return home as a hero!" 
               showRestart="true" 
               showCredits="true" />
    </beat>
    
    <!-- Combat Victory -->
    <beat>
      <id id="15" name="Combat Ending" />
      <transition type="fade" duration="2000" />
      <function kind="endScreen" 
               message="After an epic battle, you defeat the Guardian with your magic sword. The artifact is yours, but at what cost?" 
               showRestart="true" 
               showCredits="false" />
    </beat>
    
    <!-- Clever Solution -->
    <beat>
      <id id="16" name="Clever Ending" />
      <transition type="fade" duration="2000" />
      <function kind="endScreen" 
               message="Using the ancient map, you show the Guardian a forgotten path that doesn't disturb the forest. Grateful, the Guardian rewards you with the artifact and its blessing!" 
               showRestart="true" 
               showCredits="true" />
    </beat>
  </plot>
</story>
