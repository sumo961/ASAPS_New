    <beat>
      <id id="dialog_test" name="Nested Dialog Test" />
      <function kind="dialogTree" speaker="NPC" text="Hello there!"> <!--start of the conversation, no player action-->
        <choice id="c1" text="How are you?" counter="friendliness" operation="add" val="5"> <!--Player clicks this to continue conversation-->
            <dialogTree id="d2" speaker="NPC" text="I'm doing well, thanks for asking!"> <!--reaction from NPC, no player action-->
              <choice id="c2" text="That's great!" target="end_beat"/><!--Player can clicks this and then exists to end_beat-->
              <choice id="c3" text="Tell me more"> <!--Or this and then the conversation continues-->
                  <dialogTree id="d3" speaker="NPC" text="Well, it's been quite a journey..."> <!--reaction from NPC, no player action-->
                    <choice id="c4" text="I see" counter="wisdom" operation="add" val="3" target="end_beat"/> <!--Player can clicks this and then exists to end_beat-->
                  </dialogTree>
              </choice>
            </dialogTree>
        </choice>
        <choice id="c5" text="Goodbye" target="end_beat"/> <!--Player can clicks this and then exists to end_beat-->
      </function>
