{
  "name": "@asaps/renderer",
  "version": "2.0.0",
  "type": "module",
  "main": "./dist/asaps-renderer.cjs.js",
  "module": "./dist/asaps-renderer.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/asaps-renderer.es.js",
      "require": "./dist/asaps-renderer.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npx rimraf dist && vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@asaps/core": "^2.0.0",
    "@egjs/react-view360": "^4.0.0-beta.7",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
