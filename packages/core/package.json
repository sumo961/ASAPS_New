{
  "name": "@asaps/core",
  "version": "2.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./beats": {
      "import": "./dist/beats/index.js",
      "types": "./dist/beats/index.d.ts"
    },
    "./engine": {
      "import": "./dist/engine/index.js",
      "types": "./dist/engine/index.d.ts"
    },
    "./xml": {
      "import": "./dist/xml/index.js",
      "types": "./dist/xml/index.d.ts"
    },
    "./filesystem": {
      "import": "./dist/filesystem/index.js",
      "types": "./dist/filesystem/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run build:clean && npm run build:types && npm run build:js",
    "build:clean": "npx rimraf dist",
    "build:types": "tsc --declaration --declarationMap --emitDeclarationOnly --outDir dist || echo 'Type generation had warnings'",
    "build:js": "vite build",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "eventemitter3": "^5.0.1",
    "idb": "^8.0.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.52.11",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
