        "name": "Okay Ending",
        "type": "endScreen",
        "position": {
          "x": 5200,
          "y": 250
        },
        "parameters": {
          "message": "Your first day was... okay. You didn't make enemies, but you didn't find your people either. The week is young, though. Tomorrow, you'll try again.",
          "showRestart": true,
          "reset": true,
