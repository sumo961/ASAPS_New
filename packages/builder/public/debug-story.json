      {
        "id": "beat_8_symbols",
        "name": "Blackwood's Symbols",
        "type": "introText",
        "position": {
          "x": 1600,
          "y": 150
        },
        "parameters": {
          "text": "Blackwood rolls up his sleeve, revealing photographs of his father's corpse. The symbols carved into the dead man's arms writhe in the photos, as if they're moving. You feel dizzy looking at them. One symbol repeats: a branching tree with an eye at its center.",
          "buttonText": "Memorize the pattern",
          "connection": {
