    "id": "template-counter-displays",
    "name": "Counters that read affect",
    "description": "A character whose meters mirror trust, fear and mood, plus choices whose effects move them. Replace the text; keep the wiring.",
    "story": {
      "beats": [
        {
          "id": "beat_title",
          "name": "Title",
          "type": "titleScreen",
          "locations": [],
          "x": 60,
          "y": 200,
          "connections": [
            {
              "targetId": "beat_intro",
              "label": "Begin"
            }
          ],
          "parameters": {
            "title": "Your story title",
            "author": "You",
            "buttonText": "Begin"
          }
        },
        {
          "id": "beat_intro",
          "name": "Opening",
          "type": "infoText",
          "locations": [],
          "x": 320,
          "y": 200,
          "connections": [
            {
              "targetId": "beat_choice",
              "label": "Continue"
            }
          ],
          "parameters": {
            "text": "Replace this with your opening.\n\nThe meters in the corner belong to Ada. Gold is an ordinary counter. Trust, Fear and Spirits are bound to her affect state \u2014 you never set them directly; the choice effects below move the feelings underneath, and the meters follow.",
            "buttonText": "Continue"
          }
        },
        {
          "id": "beat_choice",
          "name": "A choice that moves her",
          "type": "multiChoice",
          "locations": [],
          "x": 580,
          "y": 200,
          "connections": [
            {
              "targetId": "beat_result",
              "label": "Speak gently"
            },
            {
              "targetId": "beat_result",
              "label": "Be blunt"
            },
            {
              "targetId": "beat_result",
              "label": "Raise your voice"
            },
            {
              "targetId": "beat_end",
              "label": "Stop here"
            }
          ],
          "parameters": {
            "text": "Replace this with your scene. Each choice below already carries affect effects \u2014 edit the wording, keep the effects.",
            "choices": [
              {
                "id": "gentle",
                "text": "Something kind",
                "target": "beat_result",
                "effects": [
                  {
                    "type": "addSentiment",
                    "target": "char_ada",
                    "sentimentTarget": "player",
                    "sentimentEmotion": "trust",
                    "strengthDelta": 0.25
                  },
                  {
                    "type": "nudgeMood",
                    "target": "char_ada",
                    "valenceDelta": 0.15,
                    "arousalDelta": 0
                  }
                ]
              },
              {
                "id": "blunt",
                "text": "Something blunt",
                "target": "beat_result",
                "effects": [
                  {
                    "type": "addSentiment",
                    "target": "char_ada",
                    "sentimentTarget": "player",
                    "sentimentEmotion": "trust",
                    "strengthDelta": -0.2
                  },
                  {
                    "type": "fireEmotion",
                    "target": "char_ada",
                    "emotion": "fear",
                    "emotionDelta": 0.15
                  },
                  {
                    "type": "nudgeMood",
                    "target": "char_ada",
                    "valenceDelta": -0.1,
                    "arousalDelta": 0
                  }
                ]
              },
              {
                "id": "shout",
                "text": "Something harsh",
                "target": "beat_result",
                "effects": [
                  {
                    "type": "addSentiment",
                    "target": "char_ada",
                    "sentimentTarget": "player",
                    "sentimentEmotion": "trust",
                    "strengthDelta": -0.45
                  },
                  {
                    "type": "fireEmotion",
                    "target": "char_ada",
                    "emotion": "fear",
                    "emotionDelta": 0.4
                  },
                  {
                    "type": "nudgeMood",
                    "target": "char_ada",
                    "valenceDelta": -0.3,
                    "arousalDelta": 0
                  }
                ]
              },
              {
                "id": "stop",
                "text": "Move on",
                "target": "beat_end",
                "effects": []
              }
            ]
          }
        },
        {
          "id": "beat_result",
          "name": "After",
          "type": "infoText",
          "locations": [],
          "x": 840,
          "y": 200,
          "connections": [
            {
              "targetId": "beat_choice",
              "label": "Again"
            }
          ],
          "parameters": {
            "text": "Replace this too.\n\nHer meters just moved, and no effect named a counter \u2014 the choice changed her sentiment, her fear and her mood, and the meters reported it.",
            "buttonText": "Back to the choice"
          }
        },
        {
          "id": "beat_end",
