    },
    {
     "id": "beat_end_trust",
     "name": "Ending: a friend on the strait",
     "type": "endScreen",
     "locations": [],
     "x": 1740,
     "y": 160,
     "connections": [
      {
       "targetId": "beat_title",
       "label": "Restart"
      }
     ],
     "parameters": {
      "message": "The ferry noses into the harbour at ten past one. ${@confidant} walks ${@player.name} to the ramp and doesn't say goodbye, just: \"Next time you cross, find me.\"\n\nOn the quay, ${@player.name} looks back once. ${@confidant.name} is still standing at the rail, watching ${@player.them} go.",
      "showRestart": true,
      "restartText": "Cross again as someone else",
      "reset": true
     }
    },
    {
     "id": "beat_end_alone",
     "name": "Ending: just a passenger",
     "type": "endScreen",
     "locations": [],
     "x": 1740,
     "y": 360,
     "connections": [
      {
       "targetId": "beat_title",
       "label": "Restart"
      }
     ],
     "parameters": {
      "message": "The ferry noses into the harbour at ten past one. The crew are busy with the ramp, and ${@confidant} doesn't look up as ${@player.name} walks past.\n\nIt was a crossing. ${@player.They} ${@player.was} a passenger. That is all.",
      "showRestart": true,
      "restartText": "Cross again as someone else",
      "reset": true
     }
    }
   ],
