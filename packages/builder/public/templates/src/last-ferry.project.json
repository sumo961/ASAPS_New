 "project": {
  "id": "template-last-ferry",
  "name": "The Last Ferry — choose your character",
  "description": "A night crossing played by whoever the player picks, with a crew member who becomes their confidant and a captain drawn at random — one story, several people.",
  "story": {
   "title": "The Last Ferry",
   "author": "ASAPS",
   "beats": [
    {
     "id": "beat_title",
     "name": "Title",
     "type": "titleScreen",
     "locations": [],
     "x": 60,
     "y": 260,
     "connections": [
      {
       "targetId": "beat_pick",
       "label": "Begin"
      }
     ],
     "parameters": {
      "title": "The Last Ferry",
      "subtitle": "One crossing, played by whoever you choose",
      "buttonText": "Begin"
     }
    },
    {
     "id": "beat_pick",
     "name": "Whose night is it?",
     "type": "chooseCharacter",
     "locations": [],
     "x": 300,
     "y": 260,
     "connections": [
      {
       "targetId": "beat_boarding",
       "label": "Mara"
      },
      {
       "targetId": "beat_boarding",
       "label": "Jonas"
      }
     ],
     "parameters": {
      "role": "player",
      "question": "The last ferry across the strait leaves at midnight. Whose night is it?",
      "choices": [
       {
        "id": "pick_mara",
        "character": "char_mara",
        "text": "Mara",
        "description": "A doctor at the end of a double shift, going home to her father.",
        "target": "beat_boarding"
       },
       {
        "id": "pick_jonas",
        "character": "char_jonas",
        "text": "Jonas",
        "description": "A ferry mechanic on his night off, who hates being a passenger.",
        "target": "beat_boarding"
       }
      ]
     }
    },
    {
     "id": "beat_boarding",
     "name": "Boarding",
     "type": "infoText",
     "locations": [],
     "x": 540,
     "y": 260,
     "connections": [
      {
       "targetId": "beat_argument",
       "label": "Listen"
      }
     ],
     "parameters": {
      "text": "${@player.name} runs the last fifty metres to the ramp. ${@player.They} ${@player.is} soaked by the time the gate clangs shut behind ${@player.them}.\n\nThe ferry is nearly empty: a trucker asleep across three seats, a family with too much luggage, and two of the crew arguing by the stairs. The captain comes down to see what the noise is about.",
      "buttonText": "Listen"
     }
    },
    {
     "id": "beat_argument",
     "name": "The argument",
     "type": "dialogTree",
     "locations": [],
     "x": 780,
     "y": 260,
     "connections": [],
     "parameters": {
      "dialogTree": {
       "id": "n_captain",
       "speaker": "@captain",
       "text": "Evening. ${@captain}. This is my last crossing tonight, and if the wind holds we'll be across by one.",
       "choices": [
        {
         "id": "c_n_ingrid",
         "text": "",
         "continue": true,
         "dialogNode": {
          "id": "n_ingrid",
          "speaker": "Ingrid",
          "text": "It won't hold. The forecast changed an hour ago. We should turn back while we still can.",
          "choices": [
           {
            "id": "c_n_tomas",
            "text": "",
            "continue": true,
            "dialogNode": {
             "id": "n_tomas",
             "speaker": "Tomas",
             "text": "We've crossed in worse. Turn back now and forty people sleep in their cars on the quay. Some of them have children.",
             "choices": [
              {
               "id": "c_n_ask",
               "text": "",
               "continue": true,
               "dialogNode": {
                "id": "n_ask",
                "speaker": "@captain",
                "text": "${@player.name}. You're the only passenger still awake, and you heard them both. If this were your ship — what would you do?",
                "choices": [
                 {
                  "id": "side_ingrid",
                  "text": "Turn back. Ingrid has read the weather right.",
                  "target": "beat_storm",
                  "effects": [
                   {
                    "type": "castRole",
                    "target": "confidant",
                    "character": "char_ingrid"
                   },
                   {
                    "type": "addSentiment",
                    "target": "char_ingrid",
                    "sentimentTarget": "player",
                    "sentimentEmotion": "trust",
                    "strengthDelta": 0.3
                   },
                   {
                    "type": "addSentiment",
                    "target": "char_tomas",
                    "sentimentTarget": "player",
                    "sentimentEmotion": "trust",
                    "strengthDelta": -0.1
                   }
                  ]
                 },
                 {
                  "id": "side_tomas",
                  "text": "Keep going. Tomas is right about the people below.",
                  "target": "beat_storm",
                  "effects": [
                   {
                    "type": "castRole",
                    "target": "confidant",
                    "character": "char_tomas"
                   },
                   {
                    "type": "addSentiment",
                    "target": "char_tomas",
                    "sentimentTarget": "player",
                    "sentimentEmotion": "trust",
                    "strengthDelta": 0.3
                   },
                   {
                    "type": "addSentiment",
                    "target": "char_ingrid",
                    "sentimentTarget": "player",
                    "sentimentEmotion": "trust",
                    "strengthDelta": -0.1
                   }
                  ]
                 }
                ]
               }
              }
             ]
            }
           }
          ]
         }
        }
       ]
      },
      "speaker": "@captain",
      "showSpeaker": true
     },
     "speaker": "@captain",
     "showSpeaker": true
    },
    {
     "id": "beat_storm",
     "name": "Halfway",
     "type": "multiChoice",
     "locations": [],
     "x": 1020,
     "y": 260,
     "connections": [
      {
       "targetId": "beat_confide",
       "label": "Kneel by the child and check the cut on her head."
      },
      {
       "targetId": "beat_confide",
       "label": "Follow the sound down to the engine room."
      },
      {
       "targetId": "beat_confide",
       "label": "Hold on to the rail and watch the harbour lights."
      }
     ],
     "parameters": {
      "question": "Halfway across, the ferry lurches. Somewhere below, metal groans, and a child starts to cry. ${@confidant} is already running for the stairs.",
      "choices": [
       {
        "id": "st_child",
        "text": "Kneel by the child and check the cut on her head.",
        "target": "beat_confide",
        "conditions": [
         {
          "type": "roleHolder",
          "role": "player",
          "character": "char_mara",
          "operator": "=="
         }
        ],
        "effects": [
         {
          "type": "addSentiment",
          "target": "@confidant",
          "sentimentTarget": "player",
          "sentimentEmotion": "trust",
          "strengthDelta": 0.2
         }
        ]
       },
       {
        "id": "st_engine",
        "text": "Follow the sound down to the engine room.",
        "target": "beat_confide",
        "conditions": [
         {
          "type": "roleHolder",
          "role": "player",
          "character": "char_jonas",
          "operator": "=="
         }
        ],
        "effects": [
         {
          "type": "addSentiment",
          "target": "@confidant",
          "sentimentTarget": "player",
          "sentimentEmotion": "trust",
          "strengthDelta": 0.2
         }
        ]
       },
       {
        "id": "st_rail",
        "text": "Hold on to the rail and watch the harbour lights.",
        "target": "beat_confide"
       }
      ]
     }
    },
    {
     "id": "beat_confide",
     "name": "On the stairs",
     "type": "multiChoice",
     "locations": [],
     "x": 1260,
     "y": 260,
     "connections": [
      {
       "targetId": "beat_check",
       "label": "Because I thought you were right."
      },
      {
       "targetId": "beat_check",
       "label": "Can I see the notebook?"
      },
      {
       "targetId": "beat_check",
       "label": "Don't make it a thing."
      }
     ],
     "parameters": {
      "speaker": "@confidant",
      "showSpeaker": true,
      "question": "${@confidant} finds ${@player.name} on the stairs when the worst is over. \"You backed me in front of the captain. Nobody does that. Why did you?\"",
      "choices": [
       {
        "id": "cf_meant",
        "text": "Because I thought you were right.",
        "target": "beat_check",
        "effects": [
         {
          "type": "addSentiment",
          "target": "@confidant",
          "sentimentTarget": "player",
          "sentimentEmotion": "trust",
          "strengthDelta": 0.2
         }
        ]
       },
       {
        "id": "cf_notebook",
        "text": "Can I see the notebook?",
        "target": "beat_check",
        "conditions": [
         {
          "type": "roleHolder",
          "role": "confidant",
          "character": "char_tomas",
          "operator": "=="
         }
        ],
        "effects": [
         {
          "type": "addSentiment",
          "target": "@confidant",
          "sentimentTarget": "player",
          "sentimentEmotion": "trust",
          "strengthDelta": 0.3
         }
        ]
       },
       {
        "id": "cf_shrug",
        "text": "Don't make it a thing.",
        "target": "beat_check"
       }
      ]
     },
     "speaker": "@confidant",
     "showSpeaker": true
    },
    {
     "id": "beat_check",
     "name": "Does the confidant trust you?",
     "type": "conditionBeat",
     "locations": [],
     "x": 1500,
     "y": 260,
     "connections": [],
     "parameters": {
      "conditionType": "sentiment",
      "character": "@confidant",
      "sentimentTarget": "player",
      "sentimentEmotion": "trust",
      "operator": ">=",
      "value": 0.5,
