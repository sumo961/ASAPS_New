  },
  "beats": [
    {
      "id": "t",
      "type": "titleScreen",
      "name": "Title",
      "order": 0,
      "parameters": {
        "title": "GPS Location — Verification",
        "author": "ASAPS QA",
        "buttonText": "Start",
        "connection": {
          "targetId": "intro"
        }
      },
      "locations": []
    },
    {
      "id": "intro",
      "type": "infoText",
      "name": "intro",
      "order": 1,
      "parameters": {
        "text": "Verifies the Set GPS Location beat (capture / explicit / scatter / preset), the walkable-placement option, and the dynamic geofence binding (a GpsLocation entry bound to a named point set via 'pointName').\n\nHOW TO RUN:\n• Desktop: open Tools → Mock Sensors so you can set/inject a GPS position without walking.\n• Test C (walkable) needs an internet connection at play time; offline it falls back to uniform.\n• All coordinates are around Trafalgar Square, London.",
        "buttonText": "Continue",
        "connection": {
          "targetId": "A_set"
        }
      },
      "locations": []
    },
    {
      "id": "A_set",
      "type": "setGpsLocation",
      "name": "A: Preset points",
      "order": 2,
      "parameters": {
        "mode": "preset",
        "pointName": "trailA",
        "presetPoints": [
          {
            "lat": 51.508,
            "lng": -0.1281,
            "radiusMeters": 20
          },
          {
            "lat": 51.5086,
            "lng": -0.1273
          }
        ],
        "connection": {
          "targetId": "A_gps"
        }
      },
      "locations": []
    },
    {
      "id": "A_gps",
      "type": "gpsLocation",
      "name": "A: Geofence trailA",
      "order": 3,
      "parameters": {
        "mode": "trigger-on-arrival",
        "xrLocations": [
          {
            "id": "A_gps_e",
            "name": "A: Geofence trailA",
            "pointName": "trailA",
            "target": "A_pass",
            "radiusMeters": 20
          }
        ],
        "defaultTarget": "A_fail",
        "text": "Map: points bound to 'trailA'. Tap a point / walk to it (trigger mode), or Continue (display mode).",
        "buttonText": "Continue"
      },
      "locations": []
    },
    {
      "id": "A_pass",
      "type": "infoText",
      "name": "A_pass",
      "order": 4,
      "parameters": {
        "text": "✓ PASS A — arrived at a preset point. The full loop works: preset write → pointName bind → geofence → arrival routes forward.\n\n(With Mock Sensors, set the position to 51.5080, -0.1281 to trigger this.)",
        "buttonText": "Continue",
        "connection": {
          "targetId": "B_set"
        }
      },
      "locations": []
    },
    {
      "id": "A_fail",
      "type": "infoText",
      "name": "A_fail",
      "order": 5,
      "parameters": {
        "text": "✗ A — fallback / no arrival. Open Tools → Mock Sensors and set the GPS position to 51.5080, -0.1281, then re-run. Grant location permission on a phone.",
        "buttonText": "Continue",
        "connection": {
          "targetId": "B_set"
        }
      },
      "locations": []
    },
    {
      "id": "B_set",
      "type": "setGpsLocation",
      "name": "B: Scatter (uniform)",
      "order": 6,
      "parameters": {
        "mode": "scatter",
        "pointName": "scatterB",
        "count": 5,
        "scatterRadiusMeters": 150,
        "centerSource": "explicit",
        "lat": 51.508,
        "lng": -0.1281,
        "placement": "uniform",
        "pointRadiusMeters": 20,
        "connection": {
          "targetId": "B_gps"
        }
      },
      "locations": []
    },
    {
      "id": "B_gps",
      "type": "gpsLocation",
      "name": "B: Geofence scatterB",
      "order": 7,
      "parameters": {
        "mode": "display",
