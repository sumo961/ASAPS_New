{
  "name": "@asaps/player-web",
  "version": "1.0.0",
  "description": "Embeddable web player for ASAPS interactive stories",
  "type": "module",
  "main": "./dist/player-web.umd.js",
  "module": "./dist/player-web.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/player-web.es.js",
      "require": "./dist/player-web.umd.js"
    },
    "./styles": "./dist/player-web.css"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "npx rimraf dist && vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@asaps/core": "^2.0.0",
    "@asaps/player": "^1.0.0",
    "@asaps/renderer": "^2.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.0"
  }
}
