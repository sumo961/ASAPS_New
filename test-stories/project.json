        {
          "id": "car_data",
          "name": "Car Ownership Data",
          "type": "onlineContent",
          "x": 1000,
          "y": 1000,
          "connections": [
            {
              "targetId": "ai_dialog",
              "label": "Learn More"
            }
          ],
          "parameters": {
            "sourceType": "ai-query",
            "query": "What is the car ownership rate per 1000 residents in ${playerLocation}? Also include information about public transportation availability and environmental impact of transportation in that area.",
            "displayTemplate": "{{data}}",
            "buttonText": "Learn More",
            "errorMessage": "Sorry, we couldn't retrieve data for your location. Let's continue with general information.",
            "connection": {
              "targetId": "ai_dialog"
            }
          }
        },
        {
          "id": "ai_dialog",
          "name": "AI Car Discussion",
          "type": "aiDialogTree",
          "x": 1300,
          "y": 1000,
          "connections": [
            {
              "targetId": "summary",
              "label": "To Summary"
            },
            {
              "targetId": "more_questions",
              "label": "More Topics"
            }
          ],
          "parameters": {
            "scenario": "A conversation about car ownership, transportation choices, and environmental impact based on the player's earlier responses and location.",
            "npcName": "Environmental Consultant",
            "npcPersonality": "Knowledgeable, non-judgmental, and genuinely curious about the player's perspective. Asks thoughtful follow-up questions and provides relevant information without being preachy.",
            "includeVariables": [
              "playerName",
              "playerGender",
              "playerProfession",
              "playerLocation",
              "natureConnection",
              "climateView",
              "transportChoice",
              "transportReason"
            ],
            "includeInventory": false,
            "includeVisitedBeats": true,
            "maxTurns": 3,
            "presentationMode": "chat-scroll",
            "exitTargets": [
              {
                "id": "summary",
                "description": "When the conversation reaches a natural conclusion or the player indicates they're ready to move on"
              },
              {
                "id": "more_questions",
                "description": "If the player wants to explore more environmental topics"
              }
            ],
            "systemInstructions": "Reference the player's earlier choices about nature connection and climate views. Discuss how their transportation choice relates to their stated values. Be informative about environmental impact without being preachy.",
            "choiceDelay": 0.5
          }
        },
        {
          "id": "more_questions",
          "name": "More Questions",
          "type": "introText",
          "x": 1600,
          "y": 850,
          "connections": [
            {
              "targetId": "summary",
              "label": "Continue"
            }
          ],
          "parameters": {
            "text": "There's so much more we could explore about environmental choices - from diet to energy use to consumer habits.\n\nBut for now, let's reflect on what we've discussed.",
            "buttonText": "Continue to Summary",
            "connection": {
              "targetId": "summary"
            }
          }
        },
        {
          "id": "summary",
          "name": "AI Summary",
          "type": "aiSummary",
          "x": 1600,
          "y": 1000,
          "connections": [],
          "parameters": {
            "prompt": "Create a personalized summary of this person's environmental journey. Reflect on their stated connection to nature, their views on climate, their transportation choice, and how these relate to their profession and location. Be encouraging and suggest one small actionable step they could take.",
            "includeVariables": [
