        {
          "id": "environmental_intro",
          "name": "Environmental Introduction",
          "type": "introText",
          "x": 100,
          "y": 850,
          "connections": [
            {
              "targetId": "env_dialog",
              "label": "Continue"
            }
          ],
          "parameters": {
            "text": "Thank you, ${playerName}!\n\nAs a ${playerProfession} living in ${playerLocation}, you make choices every day that impact the environment.\n\nLet's explore some of those choices together.",
            "buttonText": "Continue",
            "connection": {
              "targetId": "env_dialog"
            }
          }
        },
        {
          "id": "env_dialog",
          "name": "Environmental Views Dialog",
          "type": "dialogTree",
          "x": 100,
          "y": 1000,
          "connections": [
            {
              "targetId": "transport_choice",
              "label": "To Transport"
            }
          ],
          "parameters": {
            "dialogTree": {
              "id": "root",
              "speaker": "Environmental Guide",
              "text": "I'd like to understand your perspective on environmental issues. First, how would you describe your relationship with nature?",
              "choices": [
                {
                  "id": "c1",
                  "text": "I love spending time outdoors and feel deeply connected to nature",
                  "effects": [
                    {
                      "type": "setVariable",
                      "target": "natureConnection",
                      "value": "strong"
                    }
                  ],
                  "dialogNode": {
                    "id": "nature_strong",
                    "speaker": "Environmental Guide",
                    "text": "That's wonderful! People with a strong connection to nature often become advocates for environmental protection. What's your view on climate change?",
                    "choices": [
                      {
                        "id": "cc1",
                        "text": "It's a critical issue that requires immediate action",
                        "effects": [
                          {
                            "type": "setVariable",
                            "target": "climateView",
                            "value": "urgent"
                          }
                        ],
                        "target": "transport_choice"
                      },
                      {
                        "id": "cc2",
                        "text": "It's important but we need balanced solutions",
                        "effects": [
                          {
                            "type": "setVariable",
                            "target": "climateView",
                            "value": "moderate"
                          }
                        ],
                        "target": "transport_choice"
                      }
                    ]
                  }
                },
                {
                  "id": "c2",
                  "text": "I appreciate nature but prefer city life and modern conveniences",
                  "effects": [
                    {
                      "type": "setVariable",
                      "target": "natureConnection",
                      "value": "moderate"
                    }
                  ],
                  "dialogNode": {
                    "id": "nature_moderate",
                    "speaker": "Environmental Guide",
                    "text": "That's a common perspective. Many environmentally-conscious choices can be made even in urban settings. What's your view on climate change?",
                    "choices": [
                      {
                        "id": "cc3",
                        "text": "It's a critical issue that requires immediate action",
                        "effects": [
                          {
                            "type": "setVariable",
                            "target": "climateView",
                            "value": "urgent"
                          }
                        ],
                        "target": "transport_choice"
                      },
                      {
                        "id": "cc4",
                        "text": "The economy should come first, environment second",
                        "effects": [
                          {
                            "type": "setVariable",
                            "target": "climateView",
                            "value": "economic"
                          }
                        ],
                        "target": "transport_choice"
                      }
                    ]
                  }
                },
                {
                  "id": "c3",
                  "text": "I don't think much about environmental issues",
                  "effects": [
                    {
                      "type": "setVariable",
                      "target": "natureConnection",
                      "value": "weak"
                    }
                  ],
                  "dialogNode": {
                    "id": "nature_weak",
                    "speaker": "Environmental Guide",
                    "text": "I understand. Many people are focused on daily life challenges. Still, environmental decisions affect everyone. What matters most to you?",
                    "choices": [
                      {
                        "id": "cc5",
                        "text": "My family's health and wellbeing",
                        "effects": [
                          {
                            "type": "setVariable",
                            "target": "climateView",
                            "value": "health"
                          }
                        ],
                        "target": "transport_choice"
                      },
                      {
                        "id": "cc6",
                        "text": "Economic stability and job security",
                        "effects": [
                          {
                            "type": "setVariable",
                            "target": "climateView",
                            "value": "economic"
                          }
                        ],
                        "target": "transport_choice"
                      }
                    ]
                  }
                }
              ]
            },
            "presentationMode": "chat-scroll"
          }
        },
        {
          "id": "transport_choice",
          "name": "Transportation Choice",
          "type": "movementChoice",
          "x": 400,
          "y": 1000,
          "connections": [
            {
              "targetId": "car_selected",
              "label": "Car"
            },
            {
              "targetId": "transit_selected",
              "label": "Transit"
            },
            {
              "targetId": "active_selected",
              "label": "Bike/Walk"
            },
            {
              "targetId": "mixed_selected",
              "label": "Mixed"
            }
          ],
          "parameters": {
            "question": "Now let's think about transportation. How do you prefer to get around in your daily life?",
            "choices": [
              {
                "id": "m1",
                "text": "Drive my own car",
                "location": "Personal Vehicle",
                "target": "car_selected",
                "effects": [
                  {
                    "type": "setVariable",
                    "target": "transportChoice",
                    "value": "car"
                  }
                ]
              },
              {
                "id": "m2",
                "text": "Use public transportation",
                "location": "Public Transit",
                "target": "transit_selected",
                "effects": [
                  {
                    "type": "setVariable",
                    "target": "transportChoice",
                    "value": "transit"
                  }
                ]
              },
              {
                "id": "m3",
                "text": "Bike or walk",
                "location": "Active Transport",
                "target": "active_selected",
                "effects": [
                  {
                    "type": "setVariable",
                    "target": "transportChoice",
                    "value": "active"
                  }
                ]
              },
              {
                "id": "m4",
                "text": "Mix of options",
                "location": "Multimodal",
                "target": "mixed_selected",
                "effects": [
                  {
                    "type": "setVariable",
                    "target": "transportChoice",
                    "value": "mixed"
                  }
                ]
              }
            ]
          }
        },
