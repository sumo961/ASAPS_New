            "target": "response_apologetic"
          }
        ]
      },
      "speaker": "Group Chat",
      "text": "Madison: \"OMG where r u?? We're at the food court. Jake is here 👀\"",
      "emotion": "neutral",
      "choiceDelay": 1.5
    },
    {
      "id": "response_ignore",
      "name": "Confident Choice",
      "type": "introText",
      "locations": [],
      "connections": [
        {
          "targetId": "beat_grandma_door",
          "label": "Continue"
        }
      ],
      "x": 1100,
      "y": 50,
      "parameters": {
        "text": "You silence your phone. For the first time in weeks, you feel... lighter.\n\nThe pressure to respond instantly, to always be available, to perform for an audience - it all fades as you walk these familiar streets.\n\nMaybe you don't need their approval as much as you thought.",
        "buttonText": "Arrive at Grandma's",
        "locs": []
      }
    },
    {
      "id": "response_brief",
      "name": "Balanced Choice",
      "type": "introText",
      "locations": [],
      "connections": [
        {
          "targetId": "beat_grandma_door",
          "label": "Continue"
        }
      ],
      "x": 1100,
      "y": 150,
      "parameters": {
        "text": "You send a quick reply and put your phone away.\n\nThey send back some laughing emojis, but you notice they stopped tagging you in their stories. Whatever. You made your choice.\n\nYour phone stays quiet the rest of the walk.",
        "buttonText": "Arrive at Grandma's",
        "locs": []
      }
    },
    {
      "id": "response_apologetic",
      "name": "Anxious Choice",
      "type": "introText",
      "locations": [],
      "connections": [
        {
          "targetId": "beat_grandma_door",
          "label": "Continue"
        }
      ],
      "x": 1100,
      "y": 250,
      "parameters": {
        "text": "Madison replies: \"Whatever 🙄\"\n\nYour stomach knots. Did you just ruin everything? Will they still talk to you on Monday?\n\nThe rest of the walk is spent refreshing the group chat, watching them post stories from the mall. Each notification makes you feel worse.",
        "buttonText": "Arrive at Grandma's",
        "locs": []
      }
    },
    {
      "id": "beat_grandma_door",
      "name": "At Grandma's Door",
      "type": "dialogTree",
      "locations": [],
      "connections": [],
      "x": 1300,
      "y": 150,
      "parameters": {
        "dialogTree": {
          "id": "root",
          "text": "Oh, Riley! Come in, come in! I made your favorite tea. You look troubled, sweetheart. What's on your mind?",
          "emotion": "happy",
          "choices": [
            {
              "id": "open_up",
              "text": "Open up about feeling lost",
              "target": "grandma_wisdom"
            },
            {
              "id": "keep_surface",
              "text": "Keep it surface-level",
              "target": "grandma_surface"
            }
          ]
        },
        "speaker": "Grandma",
        "text": "Oh, Riley! Come in, come in! I made your favorite tea. You look troubled, sweetheart. What's on your mind?",
        "emotion": "happy",
        "choiceDelay": 1
      },
      "dialogTree": {
        "id": "root",
        "text": "Oh, Riley! Come in, come in! I made your favorite tea. You look troubled, sweetheart. What's on your mind?",
        "emotion": "happy",
        "choices": [
          {
            "id": "open_up",
            "text": "Open up about feeling lost",
            "target": "grandma_wisdom"
          },
          {
            "id": "keep_surface",
            "text": "Keep it surface-level",
            "target": "grandma_surface"
          }
        ]
      },
      "speaker": "Grandma",
      "text": "Oh, Riley! Come in, come in! I made your favorite tea. You look troubled, sweetheart. What's on your mind?",
      "emotion": "happy",
      "choiceDelay": 1
    },
    {
      "id": "grandma_wisdom",
      "name": "Heart to Heart",
      "type": "dialogTree",
      "locations": [],
      "connections": [
        {
          "targetId": "beat_reflection",
          "label": "Continue"
        }
      ],
      "x": 1500,
      "y": 100,
      "parameters": {
        "dialogTree": {
          "id": "root",
          "text": "Listen, Riley. When I was your age, I tried so hard to be someone I wasn't. I wore uncomfortable clothes, pretended to like things I hated, all to fit in.\n\nYou know what I learned? The people worth knowing will like you for YOU. Not the person you pretend to be.",
          "emotion": "thoughtful",
          "next": "wisdom_2"
        },
        "speaker": "Grandma",
        "text": "Listen, Riley. When I was your age, I tried so hard to be someone I wasn't. I wore uncomfortable clothes, pretended to like things I hated, all to fit in.\n\nYou know what I learned? The people worth knowing will like you for YOU. Not the person you pretend to be.",
        "emotion": "thoughtful",
        "choiceDelay": 1
      },
      "dialogTree": {
        "id": "root",
        "text": "Listen, Riley. When I was your age, I tried so hard to be someone I wasn't. I wore uncomfortable clothes, pretended to like things I hated, all to fit in.\n\nYou know what I learned? The people worth knowing will like you for YOU. Not the person you pretend to be.",
        "emotion": "thoughtful",
        "next": "wisdom_2"
      },
      "speaker": "Grandma",
      "text": "Listen, Riley. When I was your age, I tried so hard to be someone I wasn't. I wore uncomfortable clothes, pretended to like things I hated, all to fit in.\n\nYou know what I learned? The people worth knowing will like you for YOU. Not the person you pretend to be.",
      "emotion": "thoughtful",
      "choiceDelay": 1
    },
    {
      "id": "beat_mall_scene",
      "name": "At the Mall",
      "type": "introText",
      "locations": [],
      "connections": [
        {
          "targetId": "beat_mall_drama",
          "label": "Continue"
        }
      ],
      "x": 700,
      "y": 300,
      "parameters": {
        "text": "You text Grandma that you'll visit tomorrow and head to the mall.\n\nMadison waves you over to their table at the food court. Jake is there, along with Emma and Tyler - the core of the popular group.\n\n\"Finally! We thought you ghosted us,\" Madison says with a smile that doesn't quite reach her eyes.",
        "buttonText": "Join them",
        "locs": []
      }
    },
    {
      "id": "beat_mall_drama",
      "name": "Mall Drama",
      "type": "dialogTree",
      "locations": [],
      "connections": [],
      "x": 900,
      "y": 300,
      "parameters": {
        "dialogTree": {
          "id": "root",
          "text": "So, did you see what Sarah posted? She's trying SO hard. It's embarrassing.",
          "emotion": "smug",
          "choices": [
            {
              "id": "join_in",
              "text": "Laugh along with them",
              "target": "mall_join_mockery"
            },
            {
              "id": "defend",
              "text": "Actually, I think Sarah is cool",
              "target": "mall_defend"
            },
            {
              "id": "change_subject",
              "text": "Change the subject",
              "target": "mall_avoid"
            }
          ]
        },
        "speaker": "Madison",
        "text": "So, did you see what Sarah posted? She's trying SO hard. It's embarrassing.",
        "emotion": "smug",
        "choiceDelay": 2
      },
      "dialogTree": {
        "id": "root",
        "text": "So, did you see what Sarah posted? She's trying SO hard. It's embarrassing.",
        "emotion": "smug",
        "choices": [
