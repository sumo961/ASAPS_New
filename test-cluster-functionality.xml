<?xml version="1.0" encoding="UTF-8"?>
<story>
  <settings>
    <debug firstbeat="start" showvals="off" />
    <colors pcolor="#7D8DA3" palpha="90" />
    <fonts titleFont="Gothic" textFont="Arial" />
  </settings>

  <plot>
    <clusters cluster1="Mom's House" cluster2="Forest" cluster3="Grandma's House" />

    <beat x="100" y="100">
      <id id="start" name="Once Upon a Time" cluster="cluster_0" />
      <function kind="titleScreen" />
      <line title="Mom's House" />
      <text title="Once Upon a Time" />
      <transition target="forestChoice" />
    </beat>

    <beat x="300" y="100">
      <id id="forestChoice" name="Choose Your Path" cluster="cluster_1" />
      <function kind="movementChoice" />
      <text title="Where will you go?" />
      <choices>
        <choice id="toGranny" text="Go to Grandma's House" target="grannyChoice" />
        <choice id="exploreMore" text="Explore the Forest" target="deepForest" />
      </choices>
    </beat>

    <beat x="500" y="150">
      <id id="grannyChoice" name="Grandma's Garden" cluster="cluster_2" />
      <function kind="durScreen" />
      <text title="You arrive at Grandma's Garden" />
      <line time="3000" text="[The story pauses for 3 seconds]" />
      <transition target="end" />
    </beat>

    <beat x="500" y="350">
      <id id="deepForest" name="Deep in the Forest" cluster="cluster_1" />
      <function kind="introText" />
      <text title="Deep in the woods you discover..." hide="true">
        You wander deeper into the forest. The trees grow taller and darker around you.
      </text>
      <transition target="end" />
    </beat>

    <beat x="300" y="400">
      <id id="end" name="The End" />
      <function kind="endScreen" />
      <text title="The End" />
      <line text="Thank you for playing!" />
    </beat>
  </plot>
</story>